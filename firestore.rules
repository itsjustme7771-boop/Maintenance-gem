rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - name: string
    //   - role: string (admin, lead, technician)
    //   - createdAt: timestamp
    //
    // Collection: equipment
    // Document ID: {equipmentId}
    // Fields:
    //   - name: string (required)
    //   - model: string
    //   - serialNumber: string
    //   - location: string (required)
    //   - description: string
    //   - manualUrl: string
    //   - createdAt: timestamp
    //
    // Collection: equipment/{equipmentId}/logs
    // Document ID: {logId}
    // Fields:
    //   - equipmentId: string (required)
    //   - technicianId: string (required)
    //   - technicianName: string
    //   - type: string (preventative, repair, emergency)
    //   - description: string (required)
    //   - resolution: string
    //   - partsUsed: list<string>
    //   - timestamp: timestamp
    //
    // Collection: knowledge
    // Document ID: {entryId}
    // Fields:
    //   - equipmentId: string (required)
    //   - title: string (required)
    //   - content: string (required)
    //   - authorId: string (required)
    //   - authorName: string
    //   - tags: list<string>
    //   - createdAt: timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin') ||
        (request.auth.token.email == "baskintravis656@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isLead() {
      return isAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'lead');
    }

    function isTech() {
      return isAuthenticated(); // All logged in users are at least techs
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'lead', 'technician'];
    }

    function isValidEquipment(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.location is string && data.location.size() > 0 &&
             (!('description' in data) || data.description is string);
    }

    function isValidLog(data) {
      return data.equipmentId is string &&
             data.technicianId == request.auth.uid &&
             data.type in ['preventative', 'repair', 'emergency'] &&
             data.description is string && data.description.size() > 0;
    }

    function isValidKnowledge(data) {
      return data.equipmentId is string &&
             data.title is string && data.title.size() > 0 &&
             data.content is string && data.content.size() > 0 &&
             data.authorId == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'technician' || isAdmin());
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    match /equipment/{equipmentId} {
      allow read: if isAuthenticated();
      allow create: if isLead() && isValidEquipment(request.resource.data);
      allow update: if isLead() && isValidEquipment(request.resource.data);
      allow delete: if isAdmin();

      match /logs/{logId} {
        allow read: if isAuthenticated();
        allow create: if isTech() && isValidLog(request.resource.data);
        allow update: if isLead() || (isOwner(resource.data.technicianId) && isValidLog(request.resource.data));
        allow delete: if isAdmin();
      }
    }

    match /knowledge/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isTech() && isValidKnowledge(request.resource.data);
      allow update: if isLead() || (isOwner(resource.data.authorId) && isValidKnowledge(request.resource.data));
      allow delete: if isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
